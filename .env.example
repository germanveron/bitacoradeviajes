# Copiar a .env y completar. Nunca subir .env al repositorio.

# URL pública de la app (la usan los links de los mails). En local se deduce sola; en producción definirla.
APP_URL=
# Detrás de HTTPS poner 1 para que la cookie de sesión sea "Secure".
COOKIE_SECURE=0
# 1 = el primer usuario que se registra hereda los 37 lugares y 3 eventos de la Sheet. 0 = empezar vacío.
SEED_FIRST_USER=1

# Mails (restablecer contraseña, invitaciones). Sin SMTP_HOST quedan en data_local/outbox/ y en la consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Carpeta donde se guarda la base de datos y las fotos (en producción, un disco persistente).
DATA_DIR=

# Para geocodificar lugares con tools/geocode_places.py
GOOGLE_MAPS_API_KEY=
